# Neon pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/virs?sslmode=require

# Better Auth — generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend). Without a key, emails are printed to the console in development.
RESEND_API_KEY=
EMAIL_FROM="VIRS <do-not-reply@myvirs.com>"
CONTACT_EMAIL_TO=vocabinreading@gmail.com

# AWS Textract (image OCR). Credentials are read from the standard AWS environment/provider chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
