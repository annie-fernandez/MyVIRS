# Neon pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/virs?sslmode=require

# Better Auth — generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend). Without a key, emails are printed to the console in development and
# throw in production — password resets and the contact form silently do nothing.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, or Resend rejects the send. Until
# myvirs.com is verified there, use EMAIL_FROM=onboarding@resend.dev — Resend's sandbox
# sender, which only delivers to the address that owns the Resend account.
EMAIL_FROM="VIRS <do-not-reply@myvirs.com>"
# Where the contact form is delivered. A bare address, no display name.
CONTACT_EMAIL_TO=vocabinreading@gmail.com

# AWS Textract (image OCR). Credentials are read from the standard AWS environment/provider chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
