# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection (Neon). Get these from your Neon project dashboard.
# DATABASE_URL is a JDBC url, e.g.:
# jdbc:postgresql://<your-neon-host>/<dbname>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/vir
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Jasypt encryptor password (used to decrypt ENC(...) values in application.yml,
# e.g. the prod profile). Any non-empty value works for local dev.
APP_ENCRYPTION_PASSWORD=local-dev-placeholder

# Gmail SMTP credentials used to send mail from the app.
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional overrides for the dev profile's basic auth (defaults to admin/admin).
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=admin
