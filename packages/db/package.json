{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./queries/words": "./src/queries/words.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:import-legacy": "tsx --env-file-if-exists=.env scripts/import-legacy.ts",
    "db:make-admin": "tsx --env-file-if-exists=.env scripts/make-admin.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@repo/core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.5.1",
    "better-auth": "^1.7.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.9.1",
    "mysql2": "^3.24.4",
    "papaparse": "^5.7.0",
    "@types/papaparse": "^5.5.2",
    "postgres": "^3.4.9",
    "tsx": "^4.23.13"
  }
}
