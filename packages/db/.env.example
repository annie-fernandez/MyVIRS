# Neon pooled connection string (used by the app and scripts)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/virs?sslmode=require
# Neon direct connection string (used by drizzle-kit migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/virs?sslmode=require

# Only for `pnpm db:import-legacy`: the database the Java app used (postgres:// or mysql://)
LEGACY_DATABASE_URL=
